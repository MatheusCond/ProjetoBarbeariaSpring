# Copie para .env e ajuste. Nenhuma destas variaveis e necessaria para rodar o perfil
# padrao (H2 em memoria); elas valem para os perfis mysql e prod.

# Segredo HMAC do JWT: minimo 32 bytes. Gere um valor aleatorio, por exemplo com
#   openssl rand -base64 64
BARBEARIA_JWT_SEGREDO=

# true somente quando a aplicacao estiver atras de HTTPS. Em http://localhost o
# navegador descarta cookies marcados como Secure.
BARBEARIA_COOKIE_SEGURO=false

# Banco (perfil mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bdbarbearia
DB_USER=root
DB_PASSWORD=barbearia

# Criar contas de demonstracao no primeiro boot. Sempre false em producao.
BARBEARIA_DEMO=true

# Administrador criado no PRIMEIRO boot, quando ainda nao existe nenhum ADMIN ativo.
# Necessario em instalacao nova com BARBEARIA_DEMO=false: sem isso ninguem consegue
# abrir o painel. Em branco, a aplicacao registra um aviso no log e segue.
# Nao ha senha padrao de proposito; minimo de 8 caracteres. O nome exibido sai de
# BARBEARIA_ADMIN_NOME, que ja tem padrao no application.yml.
BARBEARIA_ADMIN_EMAIL=
BARBEARIA_ADMIN_SENHA=

# Porta de escuta. Hospedagens em container (Render, Koyeb, Fly.io) injetam esta
# variavel sozinhas; localmente pode deixar em branco, que o padrao e 8080.
PORT=

# Senha comum das contas de demonstracao. O padrao esta no codigo, que e publico:
# ao publicar a demonstracao em uma URL acessivel, defina um valor seu aqui.
BARBEARIA_DEMO_SENHA=
